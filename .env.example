# DO Deploy Analyzer - GitHub App Configuration

# =============================================================================
# GitHub App Credentials (from GitHub Developer Settings)
# =============================================================================

# Your GitHub App ID (found on the app's settings page)
GITHUB_APP_ID=123456

# Private key for GitHub App (PEM format)
# Replace newlines with \n when setting as env var
# Example: "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook secret (set when creating the GitHub App)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# OpenAI Configuration (for LLM analysis)
# =============================================================================

OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# Optional: Database (for storing installation configs)
# =============================================================================

# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Optional: Email Notifications
# =============================================================================

# RESEND_API_KEY=re_your_resend_api_key
# NOTIFICATION_EMAIL_FROM=noreply@your-domain.com
